diff --git a/common/in_sdl.c b/common/in_sdl.c
index 8be6bdb..8054839 100644
--- a/common/in_sdl.c
+++ b/common/in_sdl.c
@@ -39,6 +39,95 @@ cvar_t in_snd_block = { "in_snd_block", "0" };
 static qboolean mouse_available;
 static int mouse_x, mouse_y;
 
+/*
+ * The first joystick (the console's pad), read as plain SDL joystick buttons, axes and hats:
+ *  - in the game its buttons are the keys AUX1..AUX9 (button 0..8) and its four directions (the d-pad as the
+ *    console reports it - the first two axes - or a hat) AUX11..AUX14 = left, right, up, down, so config.cfg
+ *    binds them like any key;
+ *  - in the menus, the console and a message prompt the directions are the arrow keys, button 2 (Cross) is Enter
+ *    and button 1 (Circle) is Escape; button 9 (Start) is Escape everywhere.
+ * What a button or direction did when it went down is remembered, so a key never stays held when the screen
+ * changes between press and release.
+ */
+#define PAD_BUTTONS 16
+#define PAD_DEADZONE 16384
+enum { PAD_LEFT, PAD_RIGHT, PAD_UP, PAD_DOWN, PAD_DIRECTIONS };
+static SDL_Joystick *pad;
+static int pad_button_key[PAD_BUTTONS];
+static int pad_direction_key[PAD_DIRECTIONS];
+static int pad_axis_state[2];
+
+static void
+IN_PadButton(int button, qboolean down)
+{
+    int key;
+
+    if (button < 0 || button >= PAD_BUTTONS)
+	return;
+    if (!down) {
+	if (pad_button_key[button]) {
+	    Key_Event(pad_button_key[button], false);
+	    pad_button_key[button] = 0;
+	}
+	return;
+    }
+    if (button == 9) {
+	key = K_ESCAPE;
+    } else if (key_dest != key_game) {
+	if (button == 2)
+	    key = K_ENTER;
+	else if (button == 1)
+	    key = K_ESCAPE;
+	else
+	    return;
+    } else {
+	key = K_AUX1 + button;
+    }
+    pad_button_key[button] = key;
+    Key_Event(key, true);
+}
+
+static void
+IN_PadDirection(int direction, qboolean down)
+{
+    static const int menu_keys[PAD_DIRECTIONS] = { K_LEFTARROW, K_RIGHTARROW, K_UPARROW, K_DOWNARROW };
+
+    if (!down) {
+	if (pad_direction_key[direction]) {
+	    Key_Event(pad_direction_key[direction], false);
+	    pad_direction_key[direction] = 0;
+	}
+	return;
+    }
+    if (pad_direction_key[direction])
+	return;
+    pad_direction_key[direction] = (key_dest == key_game) ? K_AUX11 + direction : menu_keys[direction];
+    Key_Event(pad_direction_key[direction], true);
+}
+
+static void
+IN_PadAxis(int axis, int value)
+{
+    int state = value > PAD_DEADZONE ? 1 : value < -PAD_DEADZONE ? -1 : 0;
+    int low = axis == 0 ? PAD_LEFT : PAD_UP;
+    int high = axis == 0 ? PAD_RIGHT : PAD_DOWN;
+
+    if (axis < 0 || axis > 1 || state == pad_axis_state[axis])
+	return;
+    pad_axis_state[axis] = state;
+    IN_PadDirection(low, state < 0);
+    IN_PadDirection(high, state > 0);
+}
+
+static void
+IN_PadHat(int hat)
+{
+    IN_PadDirection(PAD_LEFT, (hat & SDL_HAT_LEFT) != 0);
+    IN_PadDirection(PAD_RIGHT, (hat & SDL_HAT_RIGHT) != 0);
+    IN_PadDirection(PAD_UP, (hat & SDL_HAT_UP) != 0);
+    IN_PadDirection(PAD_DOWN, (hat & SDL_HAT_DOWN) != 0);
+}
+
 static int have_focus = 0;
 
 static void
@@ -576,6 +665,19 @@ IN_SDL_HandleEvent(SDL_Event *event)
 	    }
 	    break;
 
+	case SDL_JOYBUTTONDOWN:
+	case SDL_JOYBUTTONUP:
+	    IN_PadButton(event->jbutton.button, event->type == SDL_JOYBUTTONDOWN);
+	    break;
+
+	case SDL_JOYAXISMOTION:
+	    IN_PadAxis(event->jaxis.axis, event->jaxis.value);
+	    break;
+
+	case SDL_JOYHATMOTION:
+	    IN_PadHat(event->jhat.value);
+	    break;
+
 	default:
 	    break;
     }
@@ -643,6 +745,12 @@ IN_Init(void)
     mouse_x = mouse_y = 0.0;
     mouse_available = !COM_CheckParm("-nomouse");
 
+    if (SDL_InitSubSystem(SDL_INIT_JOYSTICK) == 0 && SDL_NumJoysticks() > 0) {
+	pad = SDL_JoystickOpen(0);
+	if (pad)
+	    Sys_Printf("%s: pad: %s\n", __func__, SDL_JoystickName(pad));
+    }
+
     Cvar_RegisterVariable(&in_snd_block);
     Cvar_RegisterVariable(&m_filter);
     Cvar_RegisterVariable(&_windowed_mouse);
@@ -653,6 +761,10 @@ IN_Shutdown(void)
 {
     IN_UngrabMouse();
     mouse_available = 0;
+    if (pad) {
+	SDL_JoystickClose(pad);
+	pad = NULL;
+    }
 }
 
