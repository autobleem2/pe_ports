 	if (mouse_grabbed) {
@@ -676,4 +770,192 @@ void IN_Commands(void)
 		IN_GrabMouse();
 	}
     }
+
+    if(!gamecontroller_available)
+        return;
+
+    // Loop through controller buttons generating key press events
+    for(i = 0; i < GC_BUTTONS; ++i)
+    {
+        const int button_bit = 1 << i;
+        const int key_code = K_GCA + i;
+        if(SDL_GameControllerGetButton(gamecontroller, (SDL_GameControllerButton)i))
+        {
+            // Check old state
+            if((gamecontroller_buttonstate & button_bit) == 0)
+                IN_GameControllerKey(key_code, true);
+            newbuttonstate |= button_bit;
+        }
+        else if(gamecontroller_buttonstate & button_bit)
+        {
+            IN_GameControllerKey(key_code, false);
+        }
+    }
+
+    // Loop through controller triggers generating key press events
+    for(i = 0; i < 2; ++i)
+    {
+        const int button_bit = 1 << (GC_BUTTONS + i);
+        const int key_code = K_GCA + GC_BUTTONS + i;
+        if(SDL_GameControllerGetAxis(gamecontroller, SDL_CONTROLLER_AXIS_TRIGGERLEFT+i) >= TRIGGER_DEADZONE)
+        {
+            if((gamecontroller_buttonstate & button_bit) == 0)
+                IN_GameControllerKey(key_code, true);
+            newbuttonstate |= button_bit;
+        }
+        else if(gamecontroller_buttonstate & button_bit)
+        {
+            IN_GameControllerKey(key_code, false);
+        }
+    }
+    
+    gamecontroller_buttonstate = newbuttonstate;
+}
+
+/*
+===========
+IN_ControllerMove (modified IN_JoyMove (in_win.c))
+===========
+*/
+static void
+IN_ControllerMove(usercmd_t *cmd)
+{
+    int dwAxisMap[4] = { AxisSide, AxisForward, AxisTurn, AxisLook };
+    float speed, aspeed;
+    float fAxisValue;
+    int i;
+
+    // verify joystick is available and that the user wants to use it
+    if (!gamecontroller_available || !gamecontroller) {
+	return;
+    }
+
+    if ((in_speed.state & 1) ^ (int)cl_run.value)
+	speed = cl_movespeedkey.value;
+    else
+	speed = 1;
+    aspeed = speed * host_frametime;
+
+    // loop through the axes
+    for (i = 0; i < SDL_CONTROLLER_AXIS_TRIGGERLEFT; i++) {
+	// get the floating point zero-centered, potentially-inverted data for the current axis
+	fAxisValue = SDL_GameControllerGetAxis(gamecontroller, (SDL_GameControllerAxis)i);
+
+	// convert range from -32768..32767 to -1..1
+	fAxisValue /= 32768.0;
+
+	switch (dwAxisMap[i]) {
+	case AxisForward:
+	    if (((in_mlook.state & 1) ^ (int)m_freelook.value)) {
+		// user wants forward control to become look control
+		if (fabsf(fAxisValue) > joy_pitchthreshold.value) {
+		    // if mouse invert is on, invert the joystick pitch value
+		    // only absolute control support here (joy_advanced is false)
+		    if (m_pitch.value < 0.0) {
+			cl.viewangles[PITCH] -=
+			    (fAxisValue * joy_pitchsensitivity.value) *
+			    aspeed * cl_pitchspeed.value;
+		    } else {
+			cl.viewangles[PITCH] +=
+			    (fAxisValue * joy_pitchsensitivity.value) *
+			    aspeed * cl_pitchspeed.value;
+		    }
+		    V_StopPitchDrift();
+		}
+	    } else {
+		// user wants forward control to be forward control
+		if (fabsf(fAxisValue) > joy_forwardthreshold.value) {
+		    cmd->forwardmove +=
+			(fAxisValue * joy_forwardsensitivity.value) * speed *
+			cl_forwardspeed.value;
+		}
+	    }
+	    break;
+
+	case AxisSide:
+	    if (fabsf(fAxisValue) > joy_sidethreshold.value) {
+		cmd->sidemove +=
+		    (fAxisValue * joy_sidesensitivity.value) * speed *
+		    cl_sidespeed.value;
+	    }
+	    break;
+
+	case AxisTurn:
+	    if ((in_strafe.state & 1)
+		|| (lookstrafe.value && ((in_mlook.state & 1) ^ (int)m_freelook.value))) {
+		// user wants turn control to become side control
+		if (fabsf(fAxisValue) > joy_sidethreshold.value) {
+		    cmd->sidemove -=
+			(fAxisValue * joy_sidesensitivity.value) * speed *
+			cl_sidespeed.value;
+		}
+	    } else {
+		// user wants turn control to be turn control
+		if (fabsf(fAxisValue) > joy_yawthreshold.value) {
+            cl.viewangles[YAW] +=
+                (fAxisValue * joy_yawsensitivity.value) * aspeed *
+                cl_yawspeed.value;
+
+		}
+	    }
+	    break;
+
+	case AxisLook:
+		if (fabsf(fAxisValue) > joy_pitchthreshold.value) {
+		    // pitch movement detected and pitch movement desired by user
+			cl.viewangles[PITCH] +=
+			    (fAxisValue * joy_pitchsensitivity.value) *
+			    aspeed * cl_pitchspeed.value;
+		    V_StopPitchDrift();
+		}
+	    break;
+
+	default:
+	    break;
+	}
+    }
+
+    // bounds check pitch
+    if (cl.viewangles[PITCH] > 80.0)
+	cl.viewangles[PITCH] = 80.0;
+    if (cl.viewangles[PITCH] < -70.0)
+	cl.viewangles[PITCH] = -70.0;
+}
+
+static void
+IN_StartGameController(void)
+{
+    int i;
+
+    if(!gamecontroller_available || gamecontroller)
+        return;
+
+    Sys_Printf("[SDL2 GAMEPAD] Number of Joysticks: %d\n",SDL_NumJoysticks());
+
+    for(i = 0; i < SDL_NumJoysticks(); ++i)
+    {
+        Sys_Printf("[SDL2 GAMEPAD] Joystick: %s, Is a game controller = %d\n",SDL_JoystickNameForIndex(i),SDL_IsGameController(i));
+        if(SDL_IsGameController(i))
+        {
+            gamecontroller = SDL_GameControllerOpen(i);
+            if(gamecontroller) {
+                Sys_Printf("[SDL2 GAMEPAD] Connected controller %s\n",SDL_GameControllerNameForIndex(i));
+                break;
+            }
+            else
+                Sys_Printf("[SDL2 GAMEPAD](ERROR) Could not enable Controller %s: %s\n", SDL_GameControllerNameForIndex(i), SDL_GetError());
+        }
+    }
+
+    gamecontroller_buttonstate = 0;
+}
+
+static void
+IN_CloseGameController(void)
+{
+    if(gamecontroller)
+    {
+        SDL_GameControllerClose(gamecontroller);
+        gamecontroller = NULL;
+    }
 }
