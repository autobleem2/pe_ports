+/*
+ * The mode nearest to the requested size (a display with no mode of exactly that size), the first
+ * refresh rate of its group; NULL when there are no fullscreen modes at all.
+ */
+static const qvidmode_t *
+VID_NearestMode(int width, int height, int bpp)
+{
+    const qvidmode_t *mode, *best = NULL;
+    int distance, best_distance = 0;
+
+    for (mode = vid_modelist; mode - vid_modelist < vid_nummodes; mode++) {
+	if (bpp && mode->bpp != bpp)
+	    continue;
+	distance = abs(mode->width - width) + abs(mode->height - height);
+	if (!best || distance < best_distance) {
+	    best = mode;
+	    best_distance = distance;
+	}
+    }
+
+    return best;
+}
