+/*
+===============
+GLimp_GetProcAddress
+
+The OpenGL function behind a name: from the library SDL_VIDEO_GL_DRIVER names when it is set (on the console that is
+gl4es, which gives OpenGL 1.x on top of the OpenGL ES context SDL made), else SDL's own answer. SDL itself asks that
+library first only for EGL 1.4 and older; this does not depend on the EGL version.
+===============
+*/
+static void *GLimp_GetProcAddress( const char *name ) {
+	static void *library;
+	static qboolean tried;
+	void *address = NULL;
+
+	if ( !tried ) {
+		const char *path = getenv( "SDL_VIDEO_GL_DRIVER" );
+		tried = qtrue;
+		if ( path && *path ) {
+			library = SDL_LoadObject( path );
+			ri.Printf( PRINT_ALL, "OpenGL functions from %s: %s\n", path, library ? "loaded" : "not loaded, using SDL's" );
+		}
+	}
+	if ( library ) {
+		address = SDL_LoadFunction( library, name );
+	}
+	return address ? address : SDL_GL_GetProcAddress( name );
+}
+
