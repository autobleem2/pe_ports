diff --git a/code/sdl/sdl_input.c b/code/sdl/sdl_input.c
index 2ad324e3..ae320f76 100644
--- a/code/sdl/sdl_input.c
+++ b/code/sdl/sdl_input.c
@@ -47,6 +47,7 @@ static cvar_t *in_nograb;
 static cvar_t *in_joystick          = NULL;
 static cvar_t *in_joystickThreshold = NULL;
 static cvar_t *in_joystickNo        = NULL;
+static cvar_t *in_joystickGamepad   = NULL;
 static cvar_t *in_joystickUseAnalog = NULL;
 
 static int vidRestartTime = 0;
@@ -520,7 +521,9 @@ static void IN_InitJoystick( void )
 		return;
 	}
 
